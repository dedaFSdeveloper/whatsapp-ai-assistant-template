# Copy to .env and fill in. Never commit real secrets.

PORT=3000
LOG_LEVEL=info

# --- WhatsApp Cloud API (Meta) ---
# Any random string; paste the same value in the Meta app webhook settings.
WHATSAPP_VERIFY_TOKEN=change-me
# App secret, used to verify the X-Hub-Signature-256 header. Strongly recommended.
WHATSAPP_APP_SECRET=
# Permanent or system-user access token. If empty, replies are only logged (dry run).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v23.0

# --- LLM ---
# Primary provider: anthropic | openai-compatible
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high (low is usually enough for short chat replies)
ANTHROPIC_EFFORT=low

# Optional fallback: any OpenAI-compatible Chat Completions endpoint.
# Example below is Gemini's OpenAI-compatible endpoint.
FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FALLBACK_API_KEY=
FALLBACK_MODEL=gemini-2.5-flash

# --- Conversation behaviour ---
BUSINESS_CONFIG_PATH=config/business.example.json
DEBOUNCE_MS=3500
DEBOUNCE_MAX_WAIT_MS=15000
HISTORY_LIMIT=20
DEDUPE_TTL_SECONDS=86400

# --- Storage ---
# Empty = in-memory store (single instance, lost on restart).
REDIS_URL=
CONVERSATION_TTL_SECONDS=604800

# --- Integrations ---
# Optional URL that receives lead.qualified / handoff.requested events (n8n, CRM, Slack relay...).
EVENTS_WEBHOOK_URL=
# Bearer token for the /admin endpoints. Admin routes are disabled if empty.
ADMIN_TOKEN=

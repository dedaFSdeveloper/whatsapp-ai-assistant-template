{
  "name": "whatsapp-ai-assistant-template",
  "version": "0.1.0",
  "description": "Production-minded starter for a WhatsApp AI assistant for small businesses (WhatsApp Cloud API + Claude, TypeScript).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-cloud-api",
    "chatbot",
    "claude",
    "anthropic",
    "llm",
    "typescript",
    "express",
    "small-business"
  ],
  "author": "Ezequiel Molinari",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "express": "^5.3.0",
    "ioredis": "^6.1.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
